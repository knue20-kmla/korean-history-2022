  "edit": {
    "edits": {
      "s7|.ln|1": {
        "o": "1720385362",
        "h": "<span style=\"color: rgb(255, 255, 255); font-weight: 800;\">한국의 독립 문제 최초 논의</span>, ‘<span style=\"color: rgb(223, 187, 109); font-weight: 600;\">적당한 시기에 한국을 자유롭고 독립하게</span>’ 할 것 명시(카이로 선언)."
      },
      "s7|.ln|5": {
        "o": "1312579294",
        "h": "일본에 무조건 항복 요구, <span style=\"color: rgb(255, 255, 255); font-weight: 800;\">카이로 선언의 한국 독립 재확인</span>(포츠담 선언)."
      },
      "s7|.ln|7": {
        "o": "1284999959",
        "h": "일본의 무조건 항복으로 제2차 세계 대전 종결"
      },
      "s6|.ln|1": {
        "o": "-904127168",
        "h": "'재미 한족 연합 위원회'(1941)는 임시 정부 지원과 한인 국방 경위대 조직, 이승만 중심의 외교 위원회는 미국에 임시 정부 승인 요청(수용되지 않음)."
      },
      "s3|.ln|2": {
        "o": "1887699111",
        "h": "중국 신문의 아쉬움 섞인 보도에 반발한 일본인이 중국인을 습격하자, 일제가 이를 빌미로 상하이 침략(상하이 사변, 1932)"
      },
      "s3|.ln|0": {
        "o": "1611540541",
        "h": "일본 도쿄에서 일왕이 탄 마차에 수류탄 투척"
      },
      "s3|.ln|1": {
        "o": "-359871750",
        "h": "일왕 처단에는 실패했으나 일제에 큰 충격"
      },
      "s3|.ln|4": {
        "o": "-432406732",
        "h": "일본군 장교와 여러 고위 관리 처단"
      },
      "s3|.ln|3": {
        "o": "-123374252",
        "h": "상하이 훙커우 공원에서 열린 일왕 생일 및 상하이 사변 승전 기념식에 폭탄 투척"
      },
      "s3|.ln|5": {
        "o": "1144684426",
        "h": "중국인의 반한 감정 크게 완화"
      },
      "s3|.ln|6": {
        "o": "1649000267",
        "h": "<span style=\"font-weight: 800; color: rgb(255, 255, 255);\">중국 국민당 정부의 대한민국 임시 정부 본격 지원</span>"
      },
      "s3|.lead|0": {
        "o": "638747167",
        "h": "<span style=\"color: rgb(238, 213, 160);\">국민 대표회의 결렬</span> 이후 임시 정부의 활동 위축. <em>만보산 사건, 만주사변(1931)</em>으로 <span style=\"color: rgb(255, 0, 0);\">중국인의 반한 감정</span>이 커져 독립운동 곤란&nbsp;<div>김구가 임시 정부에 활기를 불어넣고자 <em>한인 애국단 조직(1931)</em>.</div>"
      },
      "s4|.ln|5": {
        "o": "-1409067270",
        "h": "다수 대원은 적극적인 항일 투쟁을 위해 화북으로 이동하여 ‘<span style=\"color: rgb(255, 255, 255); font-weight: 800;\">조선 의용대 화북 지대</span>’ 결성(1941)."
      },
      "s4|.duo-item|1": {
        "o": "-1807586814",
        "h": "임정 고수 김구 :&nbsp;<small>‘<span style=\"font-weight: 800; color: rgb(77, 163, 255); font-size: 18px;\">한국 국민당</span>’(1935)</small> 결성"
      },
      "s4|.duo-item|0": {
        "o": "-1208258642",
        "h": "난징에서 <span style=\"font-weight: 800; font-size: 18px; color: rgb(241, 96, 59);\">민족 혁명당</span> <small>(의열단 + 조선 혁명당 + 한국 독립당 등)</small> 결성"
      },
      "s4|.ln|0": {
        "o": "-575333500",
        "h": "김원봉의 의열단 계열이 당을 주도하자 <span style=\"color: rgb(209, 169, 98);\">조소앙·지청천 등 민족주의 계열 이탈.</span>"
      },
      "s4|.lead|0": {
        "o": "1354624917",
        "h": "만주 사변(1931) 이후 일제의 탄압으로 만주의 독립운동 단체 대부분 중국 관내 이동. 노선의 차이를 넘어 <em>여러 독립운동 단체의 통합</em>&nbsp;시도"
      },
      "s5|.ln|6": {
        "o": "860464894",
        "h": "<span style=\"font-weight: 600; color: rgb(242, 219, 169);\">좌우익 통일 전선의 성격 강화(독립 운동의 대표성 강화)</span>"
      },
      "s5|.lead|0": {
        "o": "551715275",
        "h": "윤봉길 의거 이후 일제의 탄압 심화로 임시 정부가 상하이를 떠나 <em>항저우 → 창사 → 광저우 → 충칭 이동</em>.&nbsp;<div>'정당·정부·군대'('한국독립당·임시 정부·한국 광복군') 체제 정비.</div>"
      },
      "s5|.ln|4": {
        "o": "1870802632",
        "h": "<span style=\"font-weight: 600; color: rgb(216, 173, 98);\">정당(한국 독립당)·정부(임시 정부)·군대(한국광복군) 체제 정비.</span>"
      },
      "s5b|.dg-n|15": {
        "o": "1167158516",
        "h": "조선 의용군 결성(1942, 옌안)"
      },
      "s3|.point h3|0": {
        "o": "1714771662",
        "h": "결과 — 한·중 항일 연대의 계기"
      }
    },
